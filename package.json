{
    "author": "ICJR",
    "dependencies": {
        "@esportsplus/utilities": "^0.28.1"
    },
    "devDependencies": {
        "@esportsplus/typescript": "^0.33.4",
        "@types/node": "^26.4.1",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    },
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        },
        "./compiler": {
            "types": "./build/compiler/index.d.ts",
            "default": "./build/compiler/index.js"
        },
        "./compiler/tsc": {
            "types": "./build/compiler/plugins/tsc.d.ts",
            "default": "./build/compiler/plugins/tsc.js"
        },
        "./compiler/vite": {
            "types": "./build/compiler/plugins/vite.d.ts",
            "default": "./build/compiler/plugins/vite.js"
        }
    },
    "main": "build/index.js",
    "name": "@esportsplus/reactivity",
    "private": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/esportsplus/reactivity"
    },
    "scripts": {
        "agent:bench": "vitest bench --run",
        "agent:test": "tsc --noEmit && vitest run",
        "bench": "vitest bench --run",
        "build": "tsc",
        "test": "vitest run",
        "-": "-",
        "prepare": "pnpm build",
        "prepublishOnly": "pnpm build"
    },
    "type": "module",
    "types": "build/index.d.ts",
    "version": "0.36.3"
}
