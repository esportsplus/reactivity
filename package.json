{
    "author": "ICJR",
    "dependencies": {
        "@esportsplus/utilities": "^0.28.6"
    },
    "devDependencies": {
        "@esportsplus/typescript": "link:../typescript",
        "@types/node": "^26.6.6",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        },
        "./compiler": {
            "types": "./build/compiler/index.d.ts",
            "default": "./build/compiler/index.js"
        },
        "./compiler/tsc": {
            "types": "./build/compiler/plugins/tsc.d.ts",
            "default": "./build/compiler/plugins/tsc.js"
        },
        "./compiler/vite": {
            "types": "./build/compiler/plugins/vite.d.ts",
            "default": "./build/compiler/plugins/vite.js"
        }
    },
    "main": "build/index.js",
    "name": "@esportsplus/reactivity",
    "packageManager": "pnpm@11.10.0",
    "private": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/esportsplus/reactivity"
    },
    "scripts": {
        "agent:bench": "vitest bench --run",
        "agent:test": "pnpm typecheck && vitest run",
        "bench": "vitest bench --run",
        "build": "tsc -p tsconfig.build.json",
        "lint": "oxlint -c oxlintrc.json --type-aware --deny-warnings",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
        "-": "-",
        "prepare": "pnpm build",
        "prepublishOnly": "pnpm build"
    },
    "type": "module",
    "types": "build/index.d.ts",
    "version": "0.40.0"
}